{
  "name": "nmac-pressing-desktop",
  "version": "1.0.0",
  "description": "Application bureau N MAC Blanchisserie (Electron)",
  "main": "main.js",
  "author": "N MAC Blanchisserie",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nmac.pressing",
    "productName": "N MAC Blanchisserie",
    "files": [
      "main.js",
      "preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "N MAC Blanchisserie"
    }
  }
}
